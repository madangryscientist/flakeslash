{
  "name": "@flakeslash/web",
  "private": true,
  "license": "Elastic-2.0",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsr generate && tsc --noEmit",
    "test": "bun --bun vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types --strict-vars=false"
  },
  "dependencies": {
    "@hackcove/flakeslash-engine": "workspace:*",
    "@hackcove/theme-catppuccin-mocha": "0.3.1",
    "@hackcove/ui-react": "0.10.2",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "drizzle-orm": "^0.45.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "wrangler": "^4.160.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.68.0",
    "@playwright/test": "1.65.0",
    "@tanstack/router-cli": "^1.168.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "vite": "^8.3.8",
    "vitest": "5.1.0"
  }
}
