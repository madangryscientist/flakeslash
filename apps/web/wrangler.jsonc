{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flakeslash-web",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // The dashboard's custom domain. Cloudflare creates and owns its DNS record and certificate: never
  // add a record for this hostname by hand, or the next deploy fails with "hostname already has a DNS
  // record".
  "routes": [{ "pattern": "flakeslash.slashslash.build", "custom_domain": true }],
  // The production database. Local dev and tests use local state.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flakeslash",
      "database_id": "4a8f9147-cba1-4040-925b-2f90ccff31a9",
      "migrations_dir": "drizzle",
    },
  ],
  // Sign-in is the GitHub App's user authorization. GITHUB_APP_CLIENT_SECRET and TOKEN_KEY (base64
  // of 32 random bytes; it seals the GitHub tokens a session keeps) are secrets: `wrangler secret
  // put`, or `.dev.vars` locally). No value of either is in the tree.
  // GITHUB_APP_PRIVATE_KEY is the App's own key, for the hourly scan (a secret too). GITHUB_APP_ID
  // and GITHUB_APP_CLIENT_ID are public; with the id or the key empty, the scan logs one line and
  // calls nothing.
  "secrets": {
    "required": ["GITHUB_APP_CLIENT_SECRET", "TOKEN_KEY", "GITHUB_APP_PRIVATE_KEY"],
  },
  // The hourly scan (src/scan/hourly.ts): no webhook, each run finds new installations itself. The
  // daily expiry at 03:30 UTC (src/expire/daily.ts) removes detailed rows past 90 days. src/cron.ts
  // picks the job by the cron string, so a change here changes EXPIRE_CRON there too.
  "triggers": { "crons": ["0 * * * *", "30 3 * * *"] },
  "vars": {
    "GITHUB_APP_CLIENT_ID": "Iv23liA7FCdQbymsYJy5",
    "GITHUB_OAUTH_BASE": "https://github.com",
    "GITHUB_API_BASE": "https://api.github.com",
    "GITHUB_APP_ID": "5771126",
    // One batch's bounds, sized for Workers Paid: 10,000 subrequests and 1,000 D1 queries per invocation
    // (a db.batch() counts as one query), 15 minutes of CPU and of wall time for a Cron Trigger.
    // SCAN_REQUEST_BUDGET counts every GitHub request. SCAN_REPOS_PER_BATCH and SCAN_D1_CAP bound the
    // D1 statements, which the request budget does not: the batch's D1 handle refuses a statement past
    // the cap (src/scan/d1-cap.ts, 950 when unset), counting every statement, batched or not, which is
    // stricter than Cloudflare's count of a batch as one. The scan in progress stops there, and the next
    // batch carries on. Measured in src/scan/hourly-bounds.test.ts at these values:
    //   20 repos with nothing new: 23 requests, 183 statements;
    //   discovery of an installation with 21 repos, then its first 20: 23 requests, 184 statements;
    //   a batch that reads new logs meets the cap: 160 runs of logs left (three tests a log) run 983
    //   statements uncapped, and stop at 950 with 183 requests;
    //   a backfill of 200 runs in each of 2 repos lands every log in 7 batches, the budget ending 6;
    //   one passing attempt of 1,000 jobs is written in full in 15 requests and 213 statements; a probe
    //   run outside the suite puts the most one attempt fitting a batch at 4,680 jobs (949 statements).
    // GitHub requests and D1 queries together stay far under the 10,000 subrequests, so the live check
    // reads Workers Logs for CPU and the request count. Discovery runs first, two requests and two
    // statements per installation: past about 99 installations it spends the whole budget.
    "SCAN_REQUEST_BUDGET": 200,
    "SCAN_REPOS_PER_BATCH": 20,
    "SCAN_D1_CAP": 950,
  },
  // `CLOUDFLARE_ENV=e2e`: the Playwright build. Bindings and vars are not inherited by an env, so they
  // repeat here. The Playwright run's `vite.config.ts` points the GitHub bases at its stand-in
  // (`e2e/github-stub.ts`) and sets the client secret and TOKEN_KEY as test vars, so they are not
  // required secrets here: a var and a secret of one name clash.
  "env": {
    "e2e": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "flakeslash",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "drizzle",
        },
      ],
      "vars": {
        "GITHUB_APP_CLIENT_ID": "",
        "GITHUB_OAUTH_BASE": "https://github.com",
        "GITHUB_API_BASE": "https://api.github.com",
        "GITHUB_APP_ID": "",
        "SCAN_REQUEST_BUDGET": 200,
        "SCAN_REPOS_PER_BATCH": 20,
        "SCAN_D1_CAP": 950,
      },
    },
  },
}
