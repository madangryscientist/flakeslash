{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flakeslash-web",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // The id is a placeholder: creating the real D1 database is the first deploy's job (a human
  // step), not this scaffold's. Local dev and tests use local state. There is no route and no
  // custom domain either: no domain is chosen yet, and attaching one is part of that first
  // deploy.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flakeslash",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle",
    },
  ],
  // Sign-in is the GitHub App's user authorization. GITHUB_APP_CLIENT_SECRET and TOKEN_KEY (base64
  // of 32 random bytes; it seals the GitHub tokens a session keeps) are secrets: `wrangler secret
  // put`, or `.dev.vars` locally). No value of either is in the tree.
  "secrets": { "required": ["GITHUB_APP_CLIENT_SECRET", "TOKEN_KEY"] },
  "vars": {
    "GITHUB_APP_CLIENT_ID": "",
    "GITHUB_OAUTH_BASE": "https://github.com",
    "GITHUB_API_BASE": "https://api.github.com",
  },
  // `CLOUDFLARE_ENV=e2e`: the Playwright build. Bindings and vars are not inherited by an env, so they
  // repeat here. The GitHub bases are GitHub's own until the e2e run has a stand-in for it.
  "env": {
    "e2e": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "flakeslash",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "drizzle",
        },
      ],
      "secrets": { "required": ["GITHUB_APP_CLIENT_SECRET", "TOKEN_KEY"] },
      "vars": {
        "GITHUB_APP_CLIENT_ID": "",
        "GITHUB_OAUTH_BASE": "https://github.com",
        "GITHUB_API_BASE": "https://api.github.com",
      },
    },
  },
}
