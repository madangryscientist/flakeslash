{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flakeslash-site",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  // The public site: every page is prerendered, so the Worker serves static files and holds no
  // data (no D1, no R2, no secrets). It has no route: no domain is chosen yet, so attaching one as a
  // custom domain is the first deploy's job, a human step.
  "workers_dev": false,
  "observability": { "enabled": false },
}
