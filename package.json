{
  "name": "flakeslash-workspace",
  "private": true,
  "license": "Elastic-2.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "flakeslash": "bun packages/cli/src/index.ts",
    "typecheck": "nx run-many -t typecheck",
    "lint": "nx run-many -t lint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "nx run-many -t test",
    "build": "nx run-many -t build",
    "test:e2e": "nx run-many -t test:e2e"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "nx": "24.0.5",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
