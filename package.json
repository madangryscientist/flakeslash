{
  "name": "flakeslash-workspace",
  "private": true,
  "license": "Elastic-2.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "flakeslash": "bun packages/cli/src/index.ts",
    "typecheck": "moon run --concurrency 3 :typecheck",
    "lint": "moon run --concurrency 3 :lint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "moon run --concurrency 3 :test",
    "build": "moon run --concurrency 3 :build",
    "test:e2e": "moon run --concurrency 3 :test-e2e"
  },
  "devDependencies": {
    "@moonrepo/cli": "2.6.5",
    "@types/bun": "1.4.4",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "trustedDependencies": [
    "@moonrepo/cli"
  ]
}
